# systemd unit for running the server without Docker.
# Install:
#   sudo useradd --system --home /opt/photobooth --shell /usr/sbin/nologin photobooth
#   sudo git clone <repo> /opt/photobooth && cd /opt/photobooth/server
#   sudo -u photobooth npm ci && sudo -u photobooth npm run build
#   sudo -u photobooth cp .env.example .env   # edit secrets, PUBLIC_BASE_URL, DATA_DIR
#   sudo cp deploy/photobooth.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now photobooth
#   journalctl -u photobooth -f
# Reload designs without restarting: sudo systemctl reload photobooth
[Unit]
Description=Photo booth server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photobooth
Group=photobooth
WorkingDirectory=/opt/photobooth/server
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/photobooth/server/data
# Add the PHOTOS_DIR here too if it lives elsewhere, e.g.:
# ReadWritePaths=/mnt/photos

[Install]
WantedBy=multi-user.target
