# Photo booth server configuration. Copy to .env (or run `npm run init-env`,
# which also generates random secrets). Never commit the real .env.

# --- Networking ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Public URL guests use (QR codes, emails, gallery links). No trailing slash.
PUBLIC_BASE_URL=http://localhost:8080
# Set to the number of reverse proxies in front of the server (Cloudflare Tunnel,
# nginx, Caddy...) so client IPs and https are detected correctly. 0 = none.
TRUST_PROXY=0

# --- Storage ------------------------------------------------------------------
DATA_DIR=./data
DESIGNS_DIR=../designs

# --- Secrets (required, at least 16 characters) --------------------------------
# Shared secret the iOS app sends as "Authorization: Bearer <key>".
DEVICE_API_KEY=
# Password for /admin (user name is ignored).
ADMIN_PASSWORD=

# --- Email (optional; leave SMTP_HOST empty to disable email) -----------------
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Photo Booth
SMTP_FROM_EMAIL=
# Abuse limits for the email endpoint.
EMAIL_MAX_PER_SESSION=3
EMAIL_MAX_PER_HOUR=200

# --- Limits / behaviour -------------------------------------------------------
MAX_UPLOAD_MB=50
# Max pixels on either side of an uploaded photo.
MAX_IMAGE_DIMENSION=12000
# Default for newly created events: false = event-wide gallery disabled.
PUBLIC_EVENT_GALLERY=false
# Log level: debug | info | warn | error
LOG_LEVEL=info
