{
  "name": "photobooth-server",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted photo booth upload API, gallery and photo strip renderer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "init-env": "node scripts/init-env.mjs",
    "seed": "tsx src/cli/seed.ts",
    "cli": "tsx src/cli/admin.ts",
    "designs": "tsx src/cli/designs.ts",
    "backup": "tsx src/cli/backup.ts",
    "generate-designs": "tsx scripts/generate-example-designs.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "nodemailer": "^10.6.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild@0.28.2": true
  }
}
